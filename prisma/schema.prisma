// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Session {
  id        Int      @id @default(autoincrement())
  matricule String
  name      String
  maxLevel  Int
  timeUsed  Int
  createdAt DateTime @default(now())
}
